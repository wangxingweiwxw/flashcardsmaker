{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdf.flashcards.local/schemas/kdf-deck-1.0.json",
  "title": "Knowledge Deck Format",
  "description": "KDF v1 is the canonical, portable format for a knowledge flashcard deck.",
  "type": "object",
  "required": ["schemaVersion", "deck", "categories", "cards"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "kdf/1.0" },
    "deck": { "$ref": "#/$defs/deck" },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" },
      "uniqueItems": true
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/card" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "deck": {
      "type": "object",
      "required": ["id", "title", "version", "defaultCardType"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string", "minLength": 1 },
        "defaultCardType": { "type": "string", "enum": ["basic", "bilingual-basic", "cloze", "qa", "image-vocabulary", "formula", "multiple-choice"] },
        "locale": { "type": "string" },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "cover": { "type": "string" }
          }
        },
        "learningMode": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "showImageFirst": { "type": "boolean" },
            "autoplayAudio": { "type": "boolean" },
            "answerReveal": { "type": "string", "enum": ["tap", "button", "auto"] },
            "showSource": { "type": "boolean" }
          }
        }
      }
    },
    "category": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" },
        "name": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "sortOrder": { "type": "integer", "minimum": 0 }
      }
    },
    "card": {
      "type": "object",
      "required": ["id", "type", "status", "front", "back"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
        "type": { "type": "string", "enum": ["basic", "bilingual-basic", "cloze", "qa", "image-vocabulary", "formula", "multiple-choice"] },
        "status": { "type": "string", "enum": ["draft", "validated", "reviewed", "published", "archived"] },
        "categoryId": { "type": "string" },
        "sectionId": { "type": "string" },
        "front": { "$ref": "#/$defs/cardSide" },
        "back": { "$ref": "#/$defs/cardSide" },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "source": { "$ref": "#/$defs/source" },
        "generation": { "$ref": "#/$defs/generation" }
      }
    },
    "cardSide": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": ["string", "array", "object", "null"] },
      "properties": {
        "primary": { "type": "string" },
        "translation": { "type": "string" },
        "prompt": { "type": "string" },
        "definition": { "type": "string" },
        "image": { "type": "string" },
        "audio": { "type": "string" },
        "phonetic": { "type": "string" },
        "example": { "type": "string" },
        "choices": { "type": "array", "items": { "type": "string" } },
        "answer": { "type": "string" },
        "explanation": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["manual", "curated", "pdf", "markdown", "text", "csv", "ai"] },
        "documentId": { "type": ["string", "null"] },
        "locator": { "type": ["string", "null"] },
        "excerpt": { "type": ["string", "null"] }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["manual", "import", "ai"] },
        "model": { "type": ["string", "null"] },
        "generatedAt": { "type": ["string", "null"], "format": "date-time" },
        "reviewedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
